# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Serwist generated service worker
/public/sw.js
/public/sw.js.map
/public/swe-worker*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database
/prisma/*.db
/prisma/*.db-journal

# uploaded images (seed placeholders are kept)
/public/uploads/**
!/public/uploads/.gitkeep
!/public/uploads/destinations/
!/public/uploads/destinations/seed-*
!/public/uploads/tours/
!/public/uploads/tours/seed-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite at repo root
/dev.db
# accidental nested build tree
/travel/

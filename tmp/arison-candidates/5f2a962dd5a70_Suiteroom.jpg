							<li><a href="https://www.instagram.com" title="Instagram"><i class="fab fa-instagram"></i></a></li>
							<li><a href="https://tripadvisor.com" title="Tripadvisor"><i class="fa fa-tripadvisor"></i></a></li>
						</ul>
					</div>
				</div>
			</div>
			<!--====== OFF CANVAS END ====== -->
			<script src="https://ezeedemo.com/epwebsite/Hotel_Royal_Orbit_templete_scripts/header-js.js">
				</script>

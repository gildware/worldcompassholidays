	<style>.carousel-caption {
    position: absolute;
    top: 50% !important;
    transform: translateY(-50%);
    display: flex;
    flex-flow: column;
    width: 60% !important;
    left: 20% !important;
    bottom: initial !important;
}
.carousel-caption h3,
.carousel-caption h5{
text-align: center;
}
.carousel-caption [data-component="button"]{
display: flex;
justify-content: center;
}
.videoWrapper{
position: relative;
overflow: hidden;
height: initial;
padding: 0;
}
.videoWrapper>iframe{
position:relative;
height: 820px;
margin-top: -60px;
margin-bottom: -60px;
}
@media (max-width: 991px){
.videoWrapper>iframe{
height: 600px;
}
}
@media (max-width: 480px){
.videoWrapper>iframe{
height: 360px;
}
}

@media (max-width: 991px){
.carousel-caption h3{
font-size: 30px !important;
}
}
@media (max-width: 500px){
.carousel-caption{
display: block !important; 
}
.carousel-caption h3{
font-size: 24px !important;
}
}
</style>


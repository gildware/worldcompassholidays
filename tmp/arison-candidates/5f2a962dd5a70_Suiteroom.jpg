                            <div class="clearfix"></div>                   
                        </div>
                    </div>
                </div><div class="swiper-slide item ">
                    <div class="slide-inner slide-bg-image" style="background-image: url('images/uploads/538/3186_574arison_luxury__61_.jpg');">
                        <div class="container">       
                            <div data-swiper-parallax="300" class="slide-title">

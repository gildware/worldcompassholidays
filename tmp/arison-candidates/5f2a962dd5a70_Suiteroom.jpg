<script>
    // Get all elements with the class 'item'
    const items = document.querySelectorAll('.item');

    // Iterate over each 'item' element
    items.forEach((item, index) =&gt; {
        // Get all h2 tags within the current 'item'
        const h2Tags = item.querySelectorAll('h2');

        // Iterate over each h2 tag within the current 'item'
        h2Tags.forEach((h2, h2Index) =&gt; {
            // Check if the current h2 tag index matches the item index
            if (h2Index !== index) {
                // If not, remove the h2 tag from the DOM
                h2.remove();
            }
        });
    });

			</script>

DATABASE_URL="file:./dev.db"

# Production bootstrap — used by `npm run db:seed` when NODE_ENV=production.
# Sign in at /admin/login (not the public /login page).
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="ChangeMeNow123"
SEED_ADMIN_NAME="Administrator"

# local | dev | prod — Cloudinary folder that receives uploads.
# Unset on a laptop uses "local". Unset when NODE_ENV=production uses "prod".
# Set APP_ENV=dev on a deployed development server.
APP_ENV="local"

# Image uploads: "local" (disk) or "cloudinary"
IMAGE_UPLOAD_DRIVER="cloudinary"

# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# Or set these instead of CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps Embed API key. Used to place destination pins.
MAP_API_KEY=""

# Firebase phone sign-in. Copy these from Firebase console → Project settings → Your apps → Web.
# Enable Authentication → Phone, allow India in the SMS region policy, and authorize this site's domain.
# Set them on the running server (container env). The sign-in page reads them on each request.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Public origin for canonical URLs, Open Graph, the sitemap, and structured data.
# Local: http://localhost:3000
# Production must be the live https origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Booking status emails (enquiry + rental). Optional.
# Without RESEND_API_KEY, status emails are logged to the server console only.
# RESEND_API_KEY=""
# MAIL_FROM="World Compass Holidays <bookings@yourdomain.com>"

    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
